<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plugin BepInEx 5 de HexOffline. Build Windows : dotnet build -c Release
       (alternative Linux sans SDK : tools/build_bepinex.sh, avec mcs). -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>HexOffline</AssemblyName>
    <RootNamespace>HexOffline</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Compile contre le mscorlib du jeu (profil Mono 2.0) : pas d'API .NET 4.x par erreur. -->
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\HEX SHARDS OF FATE</GameDir>
    <Managed>$(GameDir)\Hex_Data\Managed</Managed>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\HexOffline\src\HexOffline\Bootstrap.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Patches.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Server.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Repl.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Test.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Cheats.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Instance.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\LocalProfile.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\LocalServer.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Decks.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Champions.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\OfflineMenu.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\GameSkin.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Portraits.cs" />
    <Compile Include="..\HexOffline\src\HexOffline\Loc.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(Managed)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(Managed)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(Managed)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Xml"><HintPath>$(Managed)\System.Xml.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(Managed)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Après build : copie dans BepInEx/plugins (le jeu doit être fermé). -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\HexOffline" />
  </Target>

</Project>
